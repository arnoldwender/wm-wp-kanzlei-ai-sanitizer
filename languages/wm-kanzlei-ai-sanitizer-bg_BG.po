msgstr ""
"Извежда обобщени броячи на ИИ Санитайзера (sessions, replaced, audit_rows, "
"active_types, chain_status)."

#: includes/Integrations/EcosystemBridge.php:64
msgid "Kennzahl"
msgstr "Показател"

