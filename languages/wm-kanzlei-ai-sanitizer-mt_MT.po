msgid "Platzhalter statt erkannter Werte"
msgstr "Placeholders minflok valuri misjuba"

#: includes/Admin/AdminDashboard.php:117
msgid ""
"Ersetzt Aktenzeichen, IBAN, E-Mail, Steuer-ID, Telefonnummern, Namen nach "
"einer Anrede und Geldbeträge. Sendet nichts an KI-Anbieter."
msgstr ""
"Jibdel numri tal-kawżi, IBAN, email, ID tat-taxxa, telefowns, ismijiet wara "
"titlu u ammonti. Ma jibgħat xejn lill-fornituri tal-AI."

